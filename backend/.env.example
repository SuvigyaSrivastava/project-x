# The FULL cookie header from an authenticated browser session -- not just
# li_at. Copy it exactly as DevTools shows it.
#
# How to get it:
#   1. Sign in to linkedin.com in Chrome, on a THROWAWAY account.
#   2. DevTools (F12) -> Network -> click the Doc filter.
#   3. Hard-reload a profile page. One row appears, named after the profile.
#   4. Right-click it -> Copy -> Copy as cURL.
#   5. From what you copied, take the string after -b ' (or -H 'cookie: ')
#      and paste it below, on one line.
#
# li_at is required. JSESSIONID/bcookie/bscookie/lidc are strongly
# recommended -- without them LinkedIn is more likely to treat the session
# as a replayed cookie and kill it early. The app starts without them but
# logs a warning naming exactly what's missing.
LINKEDIN_COOKIE=bscookie="v=1&..."; JSESSIONID="ajax:..."; lidc="b=..."; li_at=AQED...; bcookie="v=2&..."

# Older two-cookie style, still accepted as a fallback if LINKEDIN_COOKIE
# isn't set -- usually not sufficient on its own (see above).
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Serve a bundled synthetic profile through the real parsing pipeline
# instead of calling LinkedIn. Lets the API run with zero LinkedIn account
# needed. Turn off for real lookups.
MOCK_MODE=true

PORT=4000

# If set, callers must send this as x-api-key (or Authorization: Bearer).
# Empty = open API.
API_KEY=

# Comma-separated allowed browser origins for the public API. "*" reflects
# any origin -- fine for review/demo, see README "Lock CORS down" once a
# frontend is deployed against this for real.
CORS_ORIGINS=*

# Cache lifetimes, in seconds. 0 disables the cache entirely.
CACHE_TTL_SECONDS=900
CACHE_STALE_SECONDS=3600

# This API's own per-IP rate limit, for callers of /api/profile.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Pacing for OUTBOUND calls to LinkedIn -- separate from the limit above.
# Live-observed finding (see README): LinkedIn's session-kill behaviour
# tracks calls landing too close together, not just raw volume. Don't drop
# LINKEDIN_MIN_INTERVAL_MS below this without re-verifying against a real
# account -- it's the single biggest lever for not getting the session
# killed.
LINKEDIN_MIN_INTERVAL_MS=1200
LINKEDIN_BURST=2

# Circuit breaker: stop calling LinkedIn entirely after this many
# consecutive auth-shaped failures (redirect loop / login wall), for this
# many seconds, rather than re-discovering a dead session on every request.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_SECONDS=30

REQUEST_TIMEOUT_MS=10000

LOG_LEVEL=info
SERVICE_NAME=linkedin-profile-api
