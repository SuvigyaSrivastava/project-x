# The FULL cookie header from an authenticated browser session -- not
# just li_at. Copy it exactly as DevTools shows it.
#
# How to get it:
#   1. Sign in to linkedin.com in Chrome, on a THROWAWAY account.
#   2. DevTools (F12) -> Network tab -> reload any profile page.
#   3. Click the request to www.linkedin.com -> Headers -> Request Headers.
#   4. Right-click the "cookie:" line -> Copy value.
#   5. Paste the whole thing below, wrapped in single quotes (it contains
#      both " and ; characters).
#
# li_at and JSESSIONID are required. bcookie/bscookie/lidc are strongly
# recommended -- without them, LinkedIn is more likely to treat the
# session as a replayed cookie and kill it early. The app will start
# without them but logs a warning naming exactly what's missing.


# Optional: require callers to send this as X-API-Key. Empty = open API.
API_KEY=

# Requests per client IP per minute. 0 disables the limiter.
RATE_LIMIT_PER_MINUTE=20

# Cache lifetimes, in seconds.
CACHE_TTL_SECONDS=3600
CACHE_STALE_SECONDS=21600

# Fetch the 5 optional per-section endpoints (positions/educations/skills/
# certifications/languages) in addition to whatever the identity call's
# own decoration already includes. Defaults to false as of 2026-08-27: two
# of these five were live-probed and confirmed dead (302 self-redirect,
# not real data); the other three are untested but likely the same. See
# app/linkedin/endpoints.py. Only turn this on once a verified-working path
# is confirmed for whichever sections you need.
FETCH_OPTIONAL_SECTIONS=false

# Off by default: LinkedIn's contact-info endpoint is the most sensitive
# part of the profile and isn't required by the brief.
ALLOW_CONTACT_INFO=false

LOG_LEVEL=INFO
